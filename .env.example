# Browser-safe Supabase project settings. Find these under
# Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Use the deployed web application's exact recovery entry URL.
# Add the same value to Authentication > URL Configuration > Redirect URLs.
VITE_SUPABASE_PASSWORD_RESET_REDIRECT_URL=https://YOUR_DOMAIN.example/web.html

# Never place the service-role key or database password in this file.
